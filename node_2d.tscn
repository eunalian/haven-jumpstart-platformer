[sub_resource type="GDScript" id="GDScript_epypp"]
resource_name = "weaponScript"
script/source = "extends Node2D

var CHARGE_TIME_s = 0.3
@onready var weapon_head = $weaponGroup
@onready var hitbox = $ShapeCast2D

var KNOCKBACK_STRENGTH = 2000

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.



# This variable should be the same as the X position of weapon_head
var weapon_head_init_pos = 80
var weapon_head_init_pos_y = 0

var charge_progress = 0

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	
	# Handles charging of the hammer once LMB is pressed
	# I tried using a while loop before using the plain if statement. _process() is already a loop. Putting a while loop inside a loop doesn't end well.
	if Input.is_action_pressed(\"fire\"):
		# 'delta' is the elapsed time since the previous frame. if CHARGE_TIME_s is defined in S we can simply repeatedly add the delta time every frame as a progress meter.
		charge_progress += delta
		if charge_progress > CHARGE_TIME_s: charge_progress = CHARGE_TIME_s
		print(charge_progress)
	
	var charge_percentage = (charge_progress / CHARGE_TIME_s)
	
	# Retract the weapon head back as charge_progress grows. I dont rlly know how the math works it just does.
	# -20 is a simple offset on the fully charged position
	# Maybe in the future I can somehow add a way to non linearly retract the head for feel
	weapon_head.position.x = weapon_head_init_pos - (20 + weapon_head_init_pos * charge_percentage)
	
	
	
	
	# Handles shake as the hammer gets progressively charged.
	# shake_multiplier takes a value (originally 20) and multiplies it by charge percentage. This is multiplied by randf() which returns a value between 0-1 
	var shake_multiplier = 20 * charge_percentage
	var rand_position = Vector2(
		weapon_head.position.x + shake_multiplier*(randf() - 0.5), 
		weapon_head_init_pos_y + shake_multiplier*(randf() - 0.5)
	)
	weapon_head.position = rand_position
	
	
	# handles firing
	if Input.is_action_just_released(\"fire\"):
		# resets charge prog to 0
		charge_progress = 0
		
		# calculates the angle needed to be fired at

		if hitbox.is_colliding():
			var mouse_pos = get_global_mouse_position()
			var global_pos = get_parent().position
			var launch_angle = (mouse_pos - global_pos).angle()
			
			get_parent().launch_by_angle_and_magnitude(launch_angle, KNOCKBACK_STRENGTH * charge_percentage)
			print(\"FIRED, ANGLE: \" + str(deg_to_rad(launch_angle)))
			
		
"

